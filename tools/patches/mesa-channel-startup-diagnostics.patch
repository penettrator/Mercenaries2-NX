+/* Opt-in startup diagnostics: preserve submitted words without changing fences. */
+static void
+mercenaries2_trace_channel_entry(struct nouveau_horizon_channel *channel,
+                                uint64_t addr, uint32_t words, uint32_t flags)
+{
+   static int enabled = -1;
+   static unsigned serial = 0;
+   if (enabled < 0) {
+      FILE *flag = fopen("sdmc:/switch/Mercenaries2/emulator_memory_test.flag", "rb");
+      enabled = flag != NULL;
+      if (flag) fclose(flag);
+   }
+   if (!enabled || serial >= 256) return;
+   const unsigned index = serial++;
+   FILE *log = fopen("sdmc:/switch/Mercenaries2/nvk-submit.log", "a");
+   if (log) {
+      fprintf(log, "entry=%u channel=%llu queued=%u addr=%llX words=%u flags=%X sync=%u\n",
+              index, (unsigned long long)channel->id, channel->gpu_channel.num_entries,
+              (unsigned long long)addr, words, flags, channel->syncpoint_id);
+      fclose(log);
+   }
+   const uint64_t size = nouveau_horizon_memory_get_size(channel->builtin_memory);
+   if (addr < channel->builtin_addr || addr - channel->builtin_addr > size ||
+       (uint64_t)words * 4 > size - (addr - channel->builtin_addr)) return;
+   char path[160];
+   snprintf(path, sizeof(path), "sdmc:/switch/Mercenaries2/nvk-entry-%03u-%llX.bin",
+            index, (unsigned long long)addr);
+   FILE *dump = fopen(path, "wb");
+   if (dump) {
+      fwrite((const char *)channel->builtin_cpu + (addr - channel->builtin_addr), 4, words, dump);
+      fclose(dump);
+   }
+}
