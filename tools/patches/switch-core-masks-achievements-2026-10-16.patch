+// switch_*_core_mask. Guest threads get their preferred core round-robin over their mask, so they do
+// not all start queued on the process default core (the kernel still migrates them inside the mask).
+void ApplySwitchCoreMask(bool guest_thread, std::string_view name) {
+  static std::atomic<uint32_t> next_guest{0};
+  static std::atomic<bool> logged{false};
+  uint32_t mask = 0;
+  int spread = -1;
+  bool audio_thread = false;
+  if (guest_thread) {
+    mask = REXCVAR_GET(switch_guest_core_mask) & 0xFu;
+    const uint32_t main_mask = REXCVAR_GET(switch_main_thread_mask) & 0xFu;
+    if (main_mask && name.starts_with("Main XThread")) mask = main_mask;
+    spread = int(next_guest.fetch_add(1, std::memory_order_relaxed) & 0xFFFF);
+  } else {
+    mask = REXCVAR_GET(switch_host_core_mask) & 0xFu;
+    const uint32_t audio = REXCVAR_GET(switch_audio_core_mask) & 0xFu;
+    if (audio && (name.starts_with("Audio Worker") || name.starts_with("XMA Decoder"))) {
+      audio_thread = true;
+      if (RexSwitchSetCurrentThreadMask(audio, -1)) mask = 0;  // done; else the host mask
+    }
+  }
+  if (mask) (void)RexSwitchSetCurrentThreadMask(mask, spread);
+  if (!logged.exchange(true, std::memory_order_relaxed)) {
+    REXSYS_INFO("[sched] process core mask 0x{:X}; thread masks: guest 0x{:X}, main 0x{:X}, host 0x{:X}, "
+                "audio 0x{:X} (0 = unchanged)",
+                RexSwitchProcessCoreMask(), REXCVAR_GET(switch_guest_core_mask),
+                REXCVAR_GET(switch_main_thread_mask), REXCVAR_GET(switch_host_core_mask),
+                REXCVAR_GET(switch_audio_core_mask));
+  }
+  (void)audio_thread;
+}
+
 }  // namespace
