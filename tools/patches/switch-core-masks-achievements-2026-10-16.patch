+uint32_t RexSwitchProcessCoreMask(void);
+
+/* The current thread may run only on the cores of `mask` (bits 0-3). Cores outside the process mask are
+ * dropped. Preferred core: with spread >= 0 the (spread % n)-th core of the mask (round-robin over
+ * threads), otherwise the current preferred core if it stays in the mask, else the lowest one.
+ * Returns whether the kernel accepted it (false: nothing usable in the mask). */
+bool RexSwitchSetCurrentThreadMask(uint32_t mask, int spread);
