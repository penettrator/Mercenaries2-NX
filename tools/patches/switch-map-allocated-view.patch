+bool RexGmMapCommittedRange(uint8_t* address, size_t length) {
+    State& s = S();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    const uint64_t start = reinterpret_cast<uint64_t>(address);
+    const uint64_t base = reinterpret_cast<uint64_t>(s.base);
+    if (!s.base || start < base || start - base >= s.size ||
+        length > s.size - (start - base)) return false;
+    const uint64_t end = start + length;
+    for (uint64_t current = start; current < end;) {
+        size_t vi = 0;
+        if (!ViewIndexFor(s, current, &vi)) return false;
+        const View& view = s.views[vi];
+        const uint64_t view_base = reinterpret_cast<uint64_t>(view.base);
+        const size_t offset = view.offset + (current - view_base);
+        Chunk* chunk = ChunkAt(s, offset);
+        if (!chunk || AccessOf(s, AlignDown(current - base, kPageSize)) != REX_GM_WRITE)
+            return false;
+        if (!s.view_mapped.count({vi, chunk->offset}) &&
+            !MapChunkIntoView(s, vi, *chunk)) return false;
+        current += std::min<uint64_t>(end - current,
+            std::min<uint64_t>(chunk->offset + chunk->length - offset,
+                              view_base + view.length - current));
+    }
+    return true;
 }
 
