@@ -0,0 +1,23 @@
+#pragma once
+// Opt-in diagnostics only. No shared Vulkan function-table or class layout changes.
+#include <atomic>
+#include <cstdio>
+#include <rex/platform.h>
+#include <rex/ui/vulkan/device.h>
+namespace rex::ui::vulkan {
+inline bool SwitchShaderStatsRequested() {
+#if REX_PLATFORM_SWITCH
+  static const bool requested = [] {
+    FILE* file = std::fopen("sdmc:/switch/Mercenaries2/logs/rex/shader_stats.flag", "rb");
+    if (!file) return false;
+    std::fclose(file);
+    return true;
+  }();
+  return requested;
+#else
+  return false;
+#endif
+}
+// Published only after successful device creation with pipelineExecutableInfo enabled.
+inline std::atomic<VkDevice> switch_shader_stats_device{VK_NULL_HANDLE};
+}
