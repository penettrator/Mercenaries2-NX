+#if REX_PLATFORM_SWITCH
+// Sparse GPU completion deltas, not isolated shader duration. All game work is retained.
+uint32_t VulkanCommandProcessor::BeginDrawTiming(uint64_t vs, uint64_t ps,
+                                                uint32_t vertices, uint32_t pitch) {
+  const auto* dev = GetVulkanDevice();
+  if (!draw_timing_checked_) {
+    draw_timing_checked_ = true;
+    const char* enabled = std::getenv("MERCENARIES2_GPU_DRAW_TIMING");
+    if (!enabled || std::strcmp(enabled, "1")) return UINT32_MAX;
+    const auto& ifn = dev->vulkan_instance()->functions();
+    uint32_t count = 0;
+    ifn.vkGetPhysicalDeviceQueueFamilyProperties(dev->physical_device(), &count, nullptr);
+    std::vector<VkQueueFamilyProperties> families(count);
+    ifn.vkGetPhysicalDeviceQueueFamilyProperties(dev->physical_device(), &count, families.data());
+    VkPhysicalDeviceProperties properties{};
+    ifn.vkGetPhysicalDeviceProperties(dev->physical_device(), &properties);
+    const uint32_t family = dev->queue_family_graphics_compute();
+    if (family >= count) return UINT32_MAX;
+    draw_timing_valid_bits_ = families[family].timestampValidBits;
+    draw_timing_period_ = properties.limits.timestampPeriod;
+    // Resolve optional diagnostics directly; do not change the shared Functions ABI.
+    const bool functions_available =
+        ifn.vkGetDeviceProcAddr(dev->device(), "vkCmdWriteTimestamp") &&
+        ifn.vkGetDeviceProcAddr(dev->device(), "vkGetQueryPoolResults");
+    draw_timing_enabled_ = functions_available && draw_timing_valid_bits_ > 0 && draw_timing_valid_bits_ <= 64 &&
+                           draw_timing_period_ > 0;
+    REXGPU_INFO("GPU_DRAW_TIMING enabled={} stride=127 max_samples=32 max_pools=8 bits={} period_ns={} metric=bottom_completion_delta",
+                draw_timing_enabled_, draw_timing_valid_bits_, draw_timing_period_);
+  }
+  if (!draw_timing_enabled_ || (++draw_timing_counter_ % 127) != 0) return UINT32_MAX;
+  if (draw_timing_current_ == UINT32_MAX ||
+      draw_timing_slots_[draw_timing_current_].submission != GetCurrentSubmission()) {
+    draw_timing_current_ = UINT32_MAX;
+    for (uint32_t i = 0; i < draw_timing_slots_.size(); ++i) {
+      auto& slot = draw_timing_slots_[i];
+      if (slot.submission) continue;
+      if (slot.pool == VK_NULL_HANDLE) {
+        VkQueryPoolCreateInfo info{};
+        info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+        info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+        info.queryCount = 64;
+        if (dev->functions().vkCreateQueryPool(dev->device(), &info, nullptr, &slot.pool) != VK_SUCCESS) {
+          draw_timing_enabled_ = false;
+          REXGPU_WARN("GPU_DRAW_TIMING disabled: query pool creation failed");
+          return UINT32_MAX;
+        }
+        slot.samples.reserve(32);
+      }
+      slot.submission = GetCurrentSubmission();
+      draw_timing_current_ = i;
+      break;
+    }
+  }
+  if (draw_timing_current_ == UINT32_MAX) return UINT32_MAX; // Never wait for diagnostic space.
+  auto& slot = draw_timing_slots_[draw_timing_current_];
+  if (slot.samples.size() >= 32) return UINT32_MAX;
+  uint32_t sample = uint32_t(slot.samples.size());
+  slot.samples.push_back({vs, ps, vertices, pitch});
+  deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                                               slot.pool, sample * 2);
+  return sample;
+}
+
+void VulkanCommandProcessor::EndDrawTiming(uint32_t sample) {
+  if (sample == UINT32_MAX) return;
+  deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+      draw_timing_slots_[draw_timing_current_].pool, sample * 2 + 1);
+}
+
+void VulkanCommandProcessor::CollectDrawTimings() {
+  const auto* dev = GetVulkanDevice();
+  for (auto& slot : draw_timing_slots_) {
+    if (!slot.submission || slot.submission > submission_completed_) continue;
+    uint64_t values[64][2]{}; // timestamp, availability
+    const uint32_t queries = uint32_t(slot.samples.size()) * 2;
+    const auto get_results = reinterpret_cast<PFN_vkGetQueryPoolResults>(
+        dev->vulkan_instance()->functions().vkGetDeviceProcAddr(dev->device(), "vkGetQueryPoolResults"));
+    VkResult status = get_results(dev->device(), slot.pool, 0, queries,
+        sizeof(values), values, sizeof(values[0]),
+        VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT);
+    const uint64_t mask = draw_timing_valid_bits_ == 64 ? UINT64_MAX :
+                          (uint64_t(1) << draw_timing_valid_bits_) - 1;
+    if (status == VK_SUCCESS) {
+      for (uint32_t i = 0; i < slot.samples.size(); ++i) {
+        if (!values[i*2][1] || !values[i*2+1][1]) continue;
+        const auto& s = slot.samples[i];
+        const uint64_t ticks = (values[i*2+1][0] - values[i*2][0]) & mask;
+        REXGPU_INFO("GPU_DRAW_SAMPLE submission={} vs={:016X} ps={:016X} vertices={} pitch={} ticks={} delta_us={:.3f}",
+            slot.submission, s.vs, s.ps, s.vertices, s.pitch, ticks,
+            double(ticks) * draw_timing_period_ / 1000.0);
+      }
+    } else {
+      REXGPU_WARN("GPU_DRAW_TIMING result discarded after completed fence: {}", int(status));
+    }
+    // Fence complete: pool may be reset/reused. No WAIT_BIT and no additional fence.
+    slot.samples.clear();
+    slot.submission = 0;
+  }
+}
+
+void VulkanCommandProcessor::ShutdownDrawTimings() {
+  const auto* dev = GetVulkanDevice();
+  // ShutdownContext has already waited for queue completion.
+  for (auto& slot : draw_timing_slots_) {
+    if (slot.pool != VK_NULL_HANDLE)
+      dev->functions().vkDestroyQueryPool(dev->device(), slot.pool, nullptr);
+    slot = {};
+  }
+  draw_timing_current_ = UINT32_MAX;
+}
+#endif
